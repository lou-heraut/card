<https://example.invalid/card/variable/RAT_ET0> a skos:Concept,
        iop:Variable ;
    dcterms:subject <https://example.invalid/card/domain/evapotranspiration>,
        <https://example.invalid/card/domain/flow>,
        <https://example.invalid/card/output/scalar>,
        <https://example.invalid/card/purpose/climate-sensitivity>,
        <https://example.invalid/card/season/annual> ;
    rdfs:isDefinedBy <https://example.invalid/card/card/RAT_ET0> ;
    skos:broader <https://example.invalid/card/family/flow.evapotranspiration.correlation.annual.scalar.climate-sensitivity.et0_obs+q_obs+q_sim> ;
    skos:definition "True when the model bias is correlated with the reference evapotranspiration, in the sense of a Spearman correlation significant at the 5 % level: performance then depends on that variable, so the model does not behave the same everywhere"@en,
        "Vrai quand le biais du modèle est corrélé à l'évapotranspiration de référence, au sens d'une corrélation de Spearman significative au seuil de 5 % : la performance dépend alors de cette variable, donc le modèle ne se comporte pas de la même façon partout"@fr ;
    skos:inScheme card: ;
    skos:notation "RAT_ET0" ;
    skos:prefLabel "Robustness test to a variation in reference evapotranspiration"@en,
        "Test de robustesse à une variation d'évapotranspiration de référence"@fr ;
    iop:hasObjectOfInterest theia:c_b45bee9c,
        theia:c_d73ddccf ;
    iop:hasProperty theia:c_7742e5f0,
        theia:c_fb752be1 ;
    iop:hasStatisticalModifier <https://example.invalid/card/statistic/correlation> .

<https://example.invalid/card/variable/RAT_R> a skos:Concept,
        iop:Variable ;
    dcterms:subject <https://example.invalid/card/domain/flow>,
        <https://example.invalid/card/domain/precipitation>,
        <https://example.invalid/card/output/scalar>,
        <https://example.invalid/card/purpose/climate-sensitivity>,
        <https://example.invalid/card/season/annual> ;
    rdfs:isDefinedBy <https://example.invalid/card/card/RAT_R> ;
    skos:broader <https://example.invalid/card/family/flow.precipitation.correlation.annual.scalar.climate-sensitivity.q_obs+q_sim+r_obs> ;
    skos:definition "True when the model bias is correlated with precipitation, in the sense of a Spearman correlation significant at the 5 % level: performance then depends on that variable, so the model does not behave the same everywhere"@en,
        "Vrai quand le biais du modèle est corrélé aux précipitations, au sens d'une corrélation de Spearman significative au seuil de 5 % : la performance dépend alors de cette variable, donc le modèle ne se comporte pas de la même façon partout"@fr ;
    skos:inScheme card: ;
    skos:notation "RAT_R" ;
    skos:prefLabel "Robustness test to a variation in precipitation"@en,
        "Test de robustesse à une variation de précipitations"@fr ;
    iop:hasObjectOfInterest theia:c_2b48133e,
        theia:c_d73ddccf ;
    iop:hasProperty theia:c_7742e5f0,
        theia:c_fb752be1 ;
    iop:hasStatisticalModifier <https://example.invalid/card/statistic/correlation> .

