<https://example.invalid/card/variable/BF-LH> a skos:Concept,
        iop:Variable ;
    dcterms:subject <https://example.invalid/card/aspect/magnitude>,
        <https://example.invalid/card/domain/flow>,
        <https://example.invalid/card/output/scalar>,
        <https://example.invalid/card/phenomenon/baseflow>,
        <https://example.invalid/card/season/record> ;
    rdfs:isDefinedBy <https://example.invalid/card/card/BF-LH> ;
    skos:broader <https://example.invalid/card/family/flow.baseflow.magnitude.filter.record.scalar.q> ;
    skos:definition "Base flow separated from the hydrograph by the Lyne and Hollick recursive filter, in three passes with a parameter of 0.925"@en,
        "Débit de base séparé de l'hydrogramme par le filtre récursif de Lyne et Hollick, en trois passes avec un paramètre de 0,925"@fr ;
    skos:inScheme card: ;
    skos:notation "BF-LH" ;
    skos:prefLabel "Base flow (Lyne and Hollick)"@en,
        "Débit de base (Lyne et Hollick)"@fr ;
    iop:hasObjectOfInterest theia:c_d73ddccf ;
    iop:hasProperty theia:c_7742e5f0 ;
    iop:hasStatisticalModifier <https://example.invalid/card/statistic/filter> .

<https://example.invalid/card/variable/BFI-LH> a skos:Concept,
        iop:Variable ;
    dcterms:subject <https://example.invalid/card/aspect/magnitude>,
        <https://example.invalid/card/domain/flow>,
        <https://example.invalid/card/output/scalar>,
        <https://example.invalid/card/phenomenon/baseflow>,
        <https://example.invalid/card/season/record> ;
    rdfs:isDefinedBy <https://example.invalid/card/card/BFI-LH> ;
    skos:broader <https://example.invalid/card/family/flow.baseflow.magnitude.ratio.record.scalar.q> ;
    skos:definition "Ratio between mean inter-annual base flow and mean inter-annual flow, the base flow being separated from the hydrograph by the Lyne and Hollick recursive filter"@en,
        "Rapport entre débit de base moyen inter-annuel et débit moyen inter-annuel, le débit de base étant séparé de l'hydrogramme par le filtre récursif de Lyne et Hollick"@fr ;
    skos:inScheme card: ;
    skos:notation "BFI-LH" ;
    skos:prefLabel "Baseflow index (Lyne and Hollick)"@en,
        "Indice de débit de base (Lyne et Hollick)"@fr ;
    iop:hasObjectOfInterest theia:c_d73ddccf ;
    iop:hasProperty theia:c_7742e5f0 ;
    iop:hasStatisticalModifier <https://example.invalid/card/statistic/ratio> .

<https://example.invalid/card/variable/BFI-Wal> a skos:Concept,
        iop:Variable ;
    dcterms:subject <https://example.invalid/card/aspect/magnitude>,
        <https://example.invalid/card/domain/flow>,
        <https://example.invalid/card/output/scalar>,
        <https://example.invalid/card/phenomenon/baseflow>,
        <https://example.invalid/card/season/record> ;
    rdfs:isDefinedBy <https://example.invalid/card/card/BFI-Wal> ;
    skos:broader <https://example.invalid/card/family/flow.baseflow.magnitude.ratio.record.scalar.q> ;
    skos:definition "Ratio between mean inter-annual base flow and mean inter-annual flow, the base flow being separated from the hydrograph by the smoothed minima method (Wallingford)"@en,
        "Rapport entre débit de base moyen inter-annuel et débit moyen inter-annuel, le débit de base étant séparé de l'hydrogramme par la méthode des minima lissés (Wallingford)"@fr ;
    skos:inScheme card: ;
    skos:notation "BFI-Wal" ;
    skos:prefLabel "Baseflow index (Wallingford)"@en,
        "Indice de débit de base (Wallingford)"@fr ;
    iop:hasObjectOfInterest theia:c_d73ddccf ;
    iop:hasProperty theia:c_7742e5f0 ;
    iop:hasStatisticalModifier <https://example.invalid/card/statistic/ratio> .

<https://example.invalid/card/variable/BFM> a skos:Concept,
        iop:Variable ;
    dcterms:subject <https://example.invalid/card/aspect/magnitude>,
        <https://example.invalid/card/domain/flow>,
        <https://example.invalid/card/output/scalar>,
        <https://example.invalid/card/phenomenon/baseflow>,
        <https://example.invalid/card/season/record> ;
    rdfs:isDefinedBy <https://example.invalid/card/card/BFM> ;
    skos:broader <https://example.invalid/card/family/flow.baseflow.magnitude.ratio.record.scalar.q> ;
    skos:definition "Relative amplitude of the inter-annual daily regime of base flow: the gap between its maximum and its minimum, divided by the maximum"@en,
        "Amplitude relative du régime journalier inter-annuel du débit de base : écart entre son maximum et son minimum, rapporté au maximum"@fr ;
    skos:inScheme card: ;
    skos:notation "BFM" ;
    skos:prefLabel "Baseflow magnitude"@en,
        "Magnitude du débit de base"@fr ;
    iop:hasObjectOfInterest theia:c_d73ddccf ;
    iop:hasProperty theia:c_7742e5f0 ;
    iop:hasStatisticalModifier <https://example.invalid/card/statistic/ratio> .

<https://example.invalid/card/variable/Bias> a skos:Concept,
        iop:Variable ;
    dcterms:subject <https://example.invalid/card/domain/flow>,
        <https://example.invalid/card/output/scalar>,
        <https://example.invalid/card/purpose/model-performance>,
        <https://example.invalid/card/season/record> ;
    rdfs:isDefinedBy <https://example.invalid/card/card/Bias> ;
    skos:broader <https://example.invalid/card/family/flow.bias.record.scalar.model-performance.q_obs+q_sim> ;
    skos:definition "Relative difference between simulated and reference data. It measures the mean deviation over the entire series."@en,
        "Différence relative entre les données simulées et de référence. Il mesure l'écart moyen sur l'ensemble de la série."@fr ;
    skos:inScheme card: ;
    skos:notation "Bias" ;
    skos:prefLabel "Bias"@en,
        "Biais"@fr ;
    iop:hasObjectOfInterest theia:c_d73ddccf ;
    iop:hasProperty theia:c_7742e5f0 ;
    iop:hasStatisticalModifier <https://example.invalid/card/statistic/bias> .

<https://example.invalid/card/variable/Bias_DJF> a skos:Concept,
        iop:Variable ;
    dcterms:subject <https://example.invalid/card/domain/flow>,
        <https://example.invalid/card/output/scalar>,
        <https://example.invalid/card/purpose/model-performance>,
        <https://example.invalid/card/season/record> ;
    rdfs:isDefinedBy <https://example.invalid/card/card/Bias_season> ;
    skos:broader <https://example.invalid/card/family/flow.bias.record.scalar.model-performance.q_obs+q_sim> ;
    skos:definition "Relative difference between simulated and reference winter data. Similar to Bias, this score measures the mean deviation only over winter months (December, January, and February)."@en,
        "Différence relative entre les données d'hiver simulées et de référence. Identique au Biais, ce score mesure l'écart moyen uniquement sur les mois d'hiver (mois de décembre, janvier et février)."@fr ;
    skos:inScheme card: ;
    skos:notation "Bias_DJF" ;
    skos:prefLabel "Winter Bias"@en,
        "Biais hivernal"@fr ;
    iop:hasObjectOfInterest theia:c_d73ddccf ;
    iop:hasProperty theia:c_7742e5f0 ;
    iop:hasStatisticalModifier <https://example.invalid/card/statistic/bias> .

