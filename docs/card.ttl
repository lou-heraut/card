<https://example.invalid/card/variable/KGE> a skos:Concept,
        iop:Variable ;
    dcterms:subject <https://example.invalid/card/domain/flow>,
        <https://example.invalid/card/output/scalar>,
        <https://example.invalid/card/purpose/model-performance>,
        <https://example.invalid/card/season/record> ;
    rdfs:isDefinedBy <https://example.invalid/card/card/KGE> ;
    skos:broader <https://example.invalid/card/family/flow.efficiency.record.scalar.model-performance.q_obs+q_sim> ;
    skos:definition "It measures the proximity between reference and simulated data series based on three sub-criteria (r, alpha, and beta) with equal weights. The coefficient gives strong weight to the reconstruction of high values of the examined variable."@en,
        "Il mesure la proximité entre les séries de données de référence et celles simulées, sur la base de trois sous-critères (r, alpha et beta) aux pondérations identiques. Le coefficient donne un poids fort à la reconstitution des valeurs fortes de la variable examinée."@fr ;
    skos:inScheme card: ;
    skos:notation "KGE" ;
    skos:prefLabel "Kling-Gupta Performance Coefficient"@en,
        "Coefficient de performance de Kling-Gupta"@fr ;
    iop:hasObjectOfInterest theia:c_d73ddccf ;
    iop:hasProperty theia:c_7742e5f0 ;
    iop:hasStatisticalModifier <https://example.invalid/card/statistic/efficiency> .

<https://example.invalid/card/variable/KGEsqrt> a skos:Concept,
        iop:Variable ;
    dcterms:subject <https://example.invalid/card/domain/flow>,
        <https://example.invalid/card/output/scalar>,
        <https://example.invalid/card/purpose/model-performance>,
        <https://example.invalid/card/season/record> ;
    rdfs:isDefinedBy <https://example.invalid/card/card/KGEsqrt> ;
    skos:broader <https://example.invalid/card/family/flow.efficiency.record.scalar.model-performance.q_obs+q_sim> ;
    skos:definition "Similar to KGE, this score gives equivalent weight across the entire range of the evaluated variable."@en,
        "Identique au KGE, ce score donne cependant un poids équivalent sur l'ensemble de la plage de variation de la variable évaluée."@fr ;
    skos:inScheme card: ;
    skos:notation "KGEsqrt" ;
    skos:prefLabel "Kling-Gupta Efficiency of the square root of data"@en,
        "Coefficient d'efficience de Kling-Gupta de la racine carrée des données"@fr ;
    iop:hasObjectOfInterest theia:c_d73ddccf ;
    iop:hasProperty theia:c_7742e5f0 ;
    iop:hasStatisticalModifier <https://example.invalid/card/statistic/efficiency> .

<https://example.invalid/card/variable/NSE> a skos:Concept,
        iop:Variable ;
