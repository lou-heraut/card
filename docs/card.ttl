        <https://example.invalid/card/card/delta-dtLF_H> ;
    skos:broader <https://example.invalid/card/family/flow.low-flows.duration.change.annual.scalar.q> ;
    skos:definition "Duration of the longest continuous sequence with 10-day mean flows below the threshold set at the maximum of VCN10"@en,
        "Durée de la plus longue séquence continue avec des débits moyens sur 10 jours sous le seuil fixé au maximum des VCN10"@fr ;
