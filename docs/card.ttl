<https://example.invalid/card/variable/rp-QMNA> a skos:Concept,
        iop:Variable ;
    dcterms:subject <https://example.invalid/card/aspect/frequency>,
        <https://example.invalid/card/domain/flow>,
        <https://example.invalid/card/output/scalar>,
